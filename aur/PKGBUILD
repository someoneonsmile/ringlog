# Maintainer: someoneonsmile <someoneonsmile@gmail.com>
pkgname=ringlog-bin
provides=('ringlog')
conflicts=('ringlog')
pkgver=0.1.0
pkgrel=1
pkgdesc="Fixed-size single-file ring log: pipe data in, overwrite oldest when full, follow with -f"
arch=('x86_64' 'aarch64')
url="https://github.com/someoneonsmile/ringlog"
license=('MIT')

_source_base="${url}/releases/download/v${pkgver}"

# 下载到 SRCDEST 的本地文件名带上 pkgver：
# 上游资产名不含版本号，若沿用原名，makepkg 会静默复用上一次缓存的 tar.gz，
# 导致「包版本是新的、内容却是旧的」。文件名随 pkgver 变化可强制重新下载。
source_x86_64=("ringlog-${pkgver}-x86_64-linux-gnu.tar.gz::${_source_base}/ringlog-x86_64-linux-gnu.tar.gz")
source_aarch64=("ringlog-${pkgver}-aarch64-linux-gnu.tar.gz::${_source_base}/ringlog-aarch64-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "$srcdir"
    tar xzf "ringlog-${pkgver}-${CARCH}-linux-gnu.tar.gz"
    install -Dm755 "ringlog-${CARCH}-linux-gnu/ringlog" "$pkgdir/usr/bin/ringlog"
    install -Dm644 "ringlog-${CARCH}-linux-gnu/complete/ringlog.bash" "$pkgdir/usr/share/bash-completion/completions/ringlog"
    install -Dm644 "ringlog-${CARCH}-linux-gnu/complete/_ringlog" "$pkgdir/usr/share/zsh/site-functions/_ringlog"
    install -Dm644 "ringlog-${CARCH}-linux-gnu/complete/ringlog.fish" "$pkgdir/usr/share/fish/vendor_completions.d/ringlog.fish"
    install -Dm644 "ringlog-${CARCH}-linux-gnu/man/ringlog.1" "$pkgdir/usr/share/man/man1/ringlog.1"
}
